# Store text as LF and check it out as LF, whatever core.autocrlf says (matches .editorconfig).
* text=auto eol=lf

# Windows scripts must be CRLF on disk: the self-checks require it for .ps1, and cmd.exe
# misparses LF-only batch files.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
